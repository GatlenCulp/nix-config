{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " "
  },
  "logo": {
    "height": 20,
    "padding": {
      "top": 1
    },
    "source": "/Users/gat/.config/nix-config/home/fastfetch/goose.txt",
    "type": "file"
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "key": "OS   ",
      "keyColor": "31",
      "type": "os"
    },
    {
      "key": " ├  ",
      "keyColor": "31",
      "type": "kernel"
    },
    {
      "key": " └  ",
      "keyColor": "31",
      "type": "shell"
    },
    "break",
    {
      "key": "WM   ",
      "keyColor": "32",
      "type": "wm"
    },
    {
      "key": " ├  ",
      "keyColor": "32",
      "type": "terminal"
    },
    {
      "key": " └  ",
      "keyColor": "32",
      "type": "terminalfont"
    },
    "break",
    {
      "format": "{5} {1} Type {2}",
      "key": "PC   ",
      "keyColor": "33",
      "type": "host"
    },
    {
      "format": "{1} ({3}) @ {7} GHz",
      "key": " ├  ",
      "keyColor": "33",
      "type": "cpu"
    },
    {
      "format": "{1} {2} @ {12} GHz",
      "key": " ├ 󰢮 ",
      "keyColor": "33",
      "type": "gpu"
    },
    {
      "key": " ├  ",
      "keyColor": "33",
      "type": "memory"
    },
    {
      "key": " ├ 󰓡 ",
      "keyColor": "33",
      "type": "swap"
    },
    {
      "key": " ├ 󰋊 ",
      "keyColor": "33",
      "type": "disk"
    },
    {
      "key": " └  ",
      "keyColor": "33",
      "type": "monitor"
    },
    "break"
  ]
}
